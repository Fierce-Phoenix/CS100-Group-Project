# Local app settings
ORDERFOOD_ENV=development
ORDERFOOD_HOST=127.0.0.1
ORDERFOOD_PORT=9000

# Required in production. Generate a long random value and keep it in a secret manager.
# ORDERFOOD_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Optional Google Maps integration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional separate server key when the browser key is HTTP-referrer restricted
# GOOGLE_MAPS_SERVER_KEY=your_server_side_google_maps_key
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_REGION=in
GOOGLE_TRAVEL_MODE=DRIVE

# Optional Razorpay checkout and marketplace payouts
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_PLATFORM_FEE_BPS=0
DELIVERY_ASSIGNMENT_STRATEGY=nearest
